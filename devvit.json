{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "which-sub-daily",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Which Sub? - create today's puzzle post",
        "description": "Builds today's puzzle from top posts and publishes it",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Which Sub? - reset my progress for today",
        "description": "Moderators only: clears your own answers, score and leaderboard entry for today so you can test again",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/reset-me"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "permissions": {
    "reddit": true
  },
  "scheduler": {
    "tasks": {
      "daily-puzzle": {
        "endpoint": "/internal/scheduler/daily",
        "cron": "5 0 * * *"
      }
    }
  },
  "dev": {
    "subreddit": "which_sub_daily_dev"
  }
}